function buildDoc(){var f=collect();var rows='';for(var s=0;s<SECS.length;s++){var sec=SECS[s];var inner='';for(var i=0;i<sec.f.length;i++){var k=sec.f[i][0];var v=f[k];if(v&&String(v).trim())inner+='<tr><td class="l">'+esc(sec.f[i][1])+'</td><td>'+esc(v)+'</td></tr>';}if(inner)rows+='<div class="sec"><h2>'+esc(sec.ico+' '+sec.t)+'</h2><table class="kv">'+inner+'</table></div>';}var A=f.arrendatariosAnteriores.filter(function(r){return r.nombre||r.rut||r.desde||r.hasta||r.arriendo||r.motivo;});var ant='';if(A.length){ant='<div class="sec"><h2>Arrendatarios anteriores</h2><table class="grid"><tr><th>Nombre</th><th>RUT</th><th>Desde</th><th>Hasta</th><th>Arriendo</th><th>Motivo</th></tr>';A.forEach(function(r){ant+='<tr><td>'+esc(r.nombre||'')+'</td><td>'+esc(r.rut||'')+'</td><td>'+esc(r.desde||'')+'</td><td>'+esc(r.hasta||'')+'</td><td>'+esc(r.arriendo||'')+'</td><td>'+esc(r.motivo||'')+'</td></tr>';});ant+='</table></div>';}var D=f.duenosAnteriores.filter(function(r){return r.propietario||r.rut||r.desde||r.hasta||r.forma||r.fojas;});var due='';if(D.length){due='<div class="sec"><h2>Propietarios anteriores</h2><table class="grid"><tr><th>Propietario</th><th>RUT</th><th>Desde</th><th>Hasta</th><th>Forma</th><th>Fojas/N°/Año</th></tr>';D.forEach(function(r){due+='<tr><td>'+esc(r.propietario||'')+'</td><td>'+esc(r.rut||'')+'</td><td>'+esc(r.desde||'')+'</td><td>'+esc(r.hasta||'')+'</td><td>'+esc(r.forma||'')+'</td><td>'+esc(r.fojas||'')+'</td></tr>';});due+='</table></div>';}var obs=(f.observaciones&&f.observaciones.trim())?'<div class="sec"><h2>Observaciones</h2><div class="obs">'+esc(f.observaciones)+'</div></div>':'';var arch='';if(ARCH.length){arch='<div class="sec"><h2>Documentos</h2><ul>';ARCH.forEach(function(a){arch+='<li><a href="'+(a.url||'#')+'">'+esc(a.name||'archivo')+'</a></li>';});arch+='</ul></div>';}var st='<style>body{font-family:Arial,sans-serif;color:#16202f;padding:18px}h1{font-size:20px;color:#1F3A5C}.sec{margin-bottom:14px}.sec h2{color:#1F3A5C;font-size:15px;border-bottom:2px solid #1F3A5C;padding-bottom:3px;margin-bottom:6px}table{width:100%;border-collapse:collapse}table.kv td{padding:5px 7px;border-bottom:1px solid #eee;font-size:13px;vertical-align:top}table.kv td.l{width:40%;color:#5a6678;background:#f7f9fc;font-weight:bold}table.grid th{background:#1F3A5C;color:#fff;padding:5px;font-size:12px;text-align:left}table.grid td{border:1px solid #ccc;padding:4px 6px;font-size:12px}.obs{white-space:pre-wrap;font-size:13px}@media print{@page{size:A4;margin:12mm}}</style>';return '<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Ficha</title>'+st+'</head><body><h1>Ficha completa — '+esc(f.alias||'Propiedad')+'</h1>'+rows+ant+due+obs+arch+'</body></html>';}
function dl(name,content,mime){var b=new Blob([content],{type:mime});var u=URL.createObjectURL(b);var a=document.createElement('a');a.href=u;a.download=name;document.body.appendChild(a);a.click();document.body.removeChild(a);setTimeout(function(){URL.revokeObjectURL(u);},1500);}
