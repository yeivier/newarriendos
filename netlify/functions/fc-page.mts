function E(id){return document.getElementById(id);}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function num(s){var x=parseFloat(String(s==null?'':s).replace(/[^0-9.\\-]/g,''));return isNaN(x)?0:x;}
function CLP(n){return '$'+Math.round(num(n)).toLocaleString('es-CL');}
function renderForm(){var h='';for(var s=0;s<SECS.length;s++){var sec=SECS[s];h+='<div class="sec"><h2>'+esc(sec.ico+' '+sec.t)+'</h2><div class="grid">';for(var i=0;i<sec.f.length;i++){var ff=sec.f[i];var key=ff[0];var lab=ff[1];var typ=(ff[2]==='date')?'date':'text';var v=DATA[key]==null?'':String(DATA[key]);h+='<div class="fld"><label>'+esc(lab)+'</label><input id="f_'+key+'" type="'+typ+'" value="'+esc(v)+'"></div>';}h+='</div></div>';}E('form').innerHTML=h;}
function renderAnt(){var h='<table class="rows"><tr><th>Nombre</th><th>RUT</th><th>Desde</th><th>Hasta</th><th>Arriendo</th><th>Motivo</th><th></th></tr>';for(var i=0;i<ANT.length;i++){var r=ANT[i];h+='<tr><td><input value="'+esc(r.nombre||'')+'" oninput="ANT['+i+'].nombre=this.value"></td><td><input value="'+esc(r.rut||'')+'" oninput="ANT['+i+'].rut=this.value"></td><td><input type="date" value="'+esc(r.desde||'')+'" oninput="ANT['+i+'].desde=this.value"></td><td><input type="date" value="'+esc(r.hasta||'')+'" oninput="ANT['+i+'].hasta=this.value"></td><td><input value="'+esc(r.arriendo||'')+'" oninput="ANT['+i+'].arriendo=this.value"></td><td><input value="'+esc(r.motivo||'')+'" oninput="ANT['+i+'].motivo=this.value"></td><td><button class="x" onclick="delAnt('+i+')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.4 6.4 17.6 17.6M17.6 6.4 6.4 17.6"/></svg></button></td></tr>';}h+='</table>';E('ant').innerHTML=h;}
